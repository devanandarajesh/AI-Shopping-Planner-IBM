# API base URL for backend recommendation service (leave empty to use local engine)
VITE_API_BASE_URL=

# Recommendation source: "local" (built-in engine) or "api" (backend service)
VITE_RECOMMENDATION_SOURCE=local

# Google Gemini API key (leave empty to use the local recommendation engine)
VITE_GEMINI_API_KEY=

# Supabase (pre-provisioned; used for future persistence)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
